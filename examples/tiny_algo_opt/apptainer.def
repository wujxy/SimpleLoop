Bootstrap: docker
From: docker.m.daocloud.io/library/almalinux:9

# Runtime for tiny_algo_opt — the minimal/lean image. The toy repository is
# pure Python (pytest + drift + bench scripts, no C++ build), so this carries
# only the base SimpleLoop runtime: bash/git/python + claude/node for the agent
# roles. It deliberately omits the gcc/cmake/freetype/X11/GL/ICU/nsl chain —
# if a future task needs to compile or drive junosw, use the shared
# examples/junosw-apptainer.def instead. The toy repo itself is supplied by
# SimpleLoop's automatic run-directory bind and is not baked into this image.

%post
    set -eux
    dnf install -y \
        bash ca-certificates diffutils findutils git which \
        python3 python3-pip python-unversioned-command tar xz
    curl -fsSLO https://nodejs.org/dist/v22.19.0/node-v22.19.0-linux-x64.tar.xz
    tar -xJf node-v22.19.0-linux-x64.tar.xz -C /usr/local --strip-components=1
    rm -f node-v22.19.0-linux-x64.tar.xz
    python3 -m pip install --no-cache-dir pytest
    npm install -g @anthropic-ai/claude-code@2.1.216
    dnf clean all
    rm -rf /var/cache/dnf

%environment
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8

%test
    command -v bash
    command -v git
    command -v node
    command -v claude
    command -v python
    command -v python3
    command -v pytest
